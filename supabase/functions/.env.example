# Environment for `supabase functions serve` (loaded automatically).
# Copy to supabase/functions/.env — it is gitignored.

# Where the app runs. Used for the Midtrans "finish" redirect and email links.
APP_URL=http://localhost:5173

# Midtrans sandbox. Leave MIDTRANS_ENABLED=false to keep the simulated checkout.
# Get the key from Dashboard -> Settings -> Access keys (Sandbox), then set
# MIDTRANS_ENABLED=true.
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Ticket email.
# Local: leave SMTP_* empty; mail is delivered to Mailpit on 54324.
# Production: set the same SMTP credentials you use for Supabase Auth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TICKETS_EMAIL_FROM=tickets@tixly.dev
TICKETS_EMAIL_FROM_NAME=Tixly

# Local Mailpit API, reached by its docker alias (the UI stays on
# http://127.0.0.1:54324). Used when SMTP_HOST is empty.
MAILPIT_URL=http://inbucket:8025
