# Supabase local development environment.
# Copy to .env.local and fill in the values from `supabase status -o env`.

# API URL of the local Supabase stack.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Public publishable key. Safe to ship in the browser bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side key. Only used by scripts/seed.mjs — never expose it to the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which backend the app talks to: "supabase" (default) or "mock".
VITE_DATA_SOURCE=supabase

# Payment copy only: "midtrans" once the gateway keys are set in
# supabase/functions/.env, "simulated" for the demo payment.
VITE_PAYMENT_MODE=simulated
